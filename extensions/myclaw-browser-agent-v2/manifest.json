{
  "manifest_version": 3,
  "name": "MyClaw Browser Agent v2",
  "version": "0.2.0",
  "description": "Generic atomic browser executor for MyClaw.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "webNavigation",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "MyClaw Browser Agent v2"
  }
}
