{
  "manifest_version": 3,
  "name": "MyClaw Browser Agent",
  "version": "0.1.0",
  "description": "Native browser control channel for MyClaw (non-MCP).",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "downloads",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "MyClaw Browser Agent"
  }
}

