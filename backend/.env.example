# LLM 配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Agent 配置
AGENT_MAX_STEPS=40
TOOL_TIMEOUT=30
MAX_RESULT_LENGTH=50000
CTX_RESERVE_TOKENS=20000
CTX_SOFT_THRESHOLD_TOKENS=4000
CTX_PRESERVE_RECENT_TURNS=4
CTX_MAX_RETRY_ON_OVERFLOW=1
CTX_MAX_TOOL_RESULT_CHARS=4000

# 工具超时与输出限制
PYTHON_EXECUTOR_TIMEOUT=180
SHELL_EXECUTOR_TIMEOUT=60
WEB_FETCH_MAX_CHARS=60000
PYTHON_EXECUTOR_MAX_CHARS=50000
SHELL_EXECUTOR_MAX_CHARS=50000

# Tavily 搜索 API (https://tavily.com 注册获取)
TAVILY_API_KEY=your-tavily-api-key-here

# Browser V3 原生扩展自动化
BROWSER_TRANSPORT=native_extension
BROWSER_GATEWAY_TIMEOUT=30
# 是否将截图作为 image_url 发给 LLM（OpenAI 兼容多模态格式）
# 默认关闭：模型仅消费截图对应的 JSON 摘要，图片仍保留本地缓存供前端渲染
BROWSER_VISION_SEND_IMAGE_TO_LLM=false
# 传给 LLM 的 marks JSON 条目上限（用于识别与判定）
BROWSER_VISION_MARKS_TO_LLM_LIMIT=260
# 图片输入来源：oss | local（当 BROWSER_VISION_SEND_IMAGE_TO_LLM=true 时生效）
BROWSER_VISION_IMAGE_SOURCE=local
# 可选：配置公网可访问的服务基址（例如 https://your-domain.com）
# 配置后，image_url 将使用 {BASE_URL}/api/browser/images/{id}，否则默认使用 data URL(base64)
# BROWSER_VISION_IMAGE_PUBLIC_BASE_URL=

# OSS（可选，若配置将用于图片上传并生成短时签名 URL）
# 示例 endpoint: https://oss-cn-hangzhou.aliyuncs.com
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PREFIX=tmp/vision/
# OSS_SIGN_EXPIRES_SECONDS=300
